package-as: TacoTip

enable-nolib-creation: no

externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: latest
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibSharedMedia-3.0: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/LibChangelog: https://github.com/BullseiWoWAddons/LibChangelog.git
  Libs/UTF8: https://github.com/Road-block/UTF8.git

ignore:
  - .github
  - CHANGELOG.md
  - .gitignore
  - README.md
  - LICENSE

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
